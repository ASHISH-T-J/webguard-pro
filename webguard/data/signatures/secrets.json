{
  "_comment": "Secret / credential patterns for HTML, JS and API responses. 'entropy' = minimum Shannon entropy of the captured secret (group 'secret' or whole match) to cut false positives.",
  "AWS Access Key ID": {
    "regex": "\\b(?P<secret>(?:AKIA|ASIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA)[A-Z0-9]{16})\\b",
    "severity": "HIGH"
  },
  "AWS Secret Access Key": {
    "regex": "(?i)aws.{0,20}?(?:secret|private).{0,20}?['\"](?P<secret>[A-Za-z0-9/+=]{40})['\"]",
    "severity": "CRITICAL",
    "entropy": 4.0
  },
  "Google API Key": {
    "regex": "\\b(?P<secret>AIza[0-9A-Za-z\\-_]{35})\\b",
    "severity": "MEDIUM"
  },
  "Google OAuth Client Secret": {
    "regex": "\\b(?P<secret>GOCSPX-[0-9A-Za-z\\-_]{28})\\b",
    "severity": "HIGH"
  },
  "GCP Service Account": {
    "regex": "\"type\":\\s*\"service_account\"",
    "severity": "CRITICAL"
  },
  "Firebase Database URL": {
    "regex": "(?P<secret>[a-z0-9.-]+\\.firebaseio\\.com)",
    "severity": "INFO"
  },
  "GitHub Token": {
    "regex": "\\b(?P<secret>(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,255})\\b",
    "severity": "CRITICAL"
  },
  "GitHub Fine-grained Token": {
    "regex": "\\b(?P<secret>github_pat_[A-Za-z0-9_]{82})\\b",
    "severity": "CRITICAL"
  },
  "GitLab Token": {
    "regex": "\\b(?P<secret>glpat-[A-Za-z0-9\\-_]{20})\\b",
    "severity": "CRITICAL"
  },
  "Slack Token": {
    "regex": "\\b(?P<secret>xox[baprs]-[0-9A-Za-z-]{10,72})\\b",
    "severity": "HIGH"
  },
  "Slack Webhook": {
    "regex": "(?P<secret>https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+)",
    "severity": "MEDIUM"
  },
  "Discord Webhook": {
    "regex": "(?P<secret>https://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_-]+)",
    "severity": "MEDIUM"
  },
  "Stripe Secret Key": {
    "regex": "\\b(?P<secret>(?:sk|rk)_live_[0-9a-zA-Z]{24,99})\\b",
    "severity": "CRITICAL"
  },
  "Stripe Publishable Key": {
    "regex": "\\b(?P<secret>pk_live_[0-9a-zA-Z]{24,99})\\b",
    "severity": "INFO"
  },
  "Twilio API Key": {
    "regex": "\\b(?P<secret>SK[0-9a-fA-F]{32})\\b",
    "severity": "HIGH",
    "entropy": 3.5
  },
  "SendGrid API Key": {
    "regex": "\\b(?P<secret>SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43})\\b",
    "severity": "HIGH"
  },
  "Mailgun API Key": {
    "regex": "\\b(?P<secret>key-[0-9a-zA-Z]{32})\\b",
    "severity": "HIGH",
    "entropy": 3.5
  },
  "Mailchimp API Key": {
    "regex": "\\b(?P<secret>[0-9a-f]{32}-us\\d{1,2})\\b",
    "severity": "HIGH"
  },
  "Shopify Token": {
    "regex": "\\b(?P<secret>shp(?:at|ca|pa|ss)_[a-fA-F0-9]{32})\\b",
    "severity": "HIGH"
  },
  "OpenAI API Key": {
    "regex": "\\b(?P<secret>sk-(?:proj-)?[A-Za-z0-9_-]{20,}T3BlbkFJ[A-Za-z0-9_-]{20,})\\b",
    "severity": "HIGH"
  },
  "Anthropic API Key": {
    "regex": "\\b(?P<secret>sk-ant-(?:api|admin)\\d{2}-[A-Za-z0-9_-]{80,})\\b",
    "severity": "HIGH"
  },
  "Hugging Face Token": {
    "regex": "\\b(?P<secret>hf_[A-Za-z0-9]{34,})\\b",
    "severity": "HIGH"
  },
  "NPM Token": {
    "regex": "\\b(?P<secret>npm_[A-Za-z0-9]{36})\\b",
    "severity": "HIGH"
  },
  "PyPI Token": {
    "regex": "\\b(?P<secret>pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,})\\b",
    "severity": "HIGH"
  },
  "Heroku API Key": {
    "regex": "(?i)heroku.{0,20}?['\"](?P<secret>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})['\"]",
    "severity": "HIGH"
  },
  "Azure Storage Connection String": {
    "regex": "(?P<secret>DefaultEndpointsProtocol=https?;AccountName=[^;]+;AccountKey=[A-Za-z0-9+/=]{60,})",
    "severity": "CRITICAL"
  },
  "Azure SAS Token": {
    "regex": "(?P<secret>[?&]sig=[A-Za-z0-9%]{40,}&?)",
    "severity": "MEDIUM"
  },
  "Private Key": {
    "regex": "(?P<secret>-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----)",
    "severity": "CRITICAL"
  },
  "JSON Web Token": {
    "regex": "\\b(?P<secret>eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})\\b",
    "severity": "MEDIUM"
  },
  "Basic Auth in URL": {
    "regex": "(?P<secret>[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s/:@'\"]{2,}:[^\\s/:@'\"]{3,}@[a-zA-Z0-9.-]+)",
    "severity": "HIGH"
  },
  "Database Connection URI": {
    "regex": "(?P<secret>(?:mongodb(?:\\+srv)?|postgres(?:ql)?|mysql|redis|amqp)://[^\\s:'\"]+:[^\\s@'\"]+@[^\\s'\"]+)",
    "severity": "CRITICAL"
  },
  "Generic API Key Assignment": {
    "regex": "(?i)(?:api[_-]?key|apikey|secret[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)['\"]?\\s*[:=]\\s*['\"](?P<secret>[A-Za-z0-9_\\-./+=]{20,})['\"]",
    "severity": "MEDIUM",
    "entropy": 3.7
  },
  "Generic Password Assignment": {
    "regex": "(?i)(?:password|passwd|pwd)['\"]?\\s*[:=]\\s*['\"](?P<secret>[A-Za-z0-9!@#%^&*_+\\-=.~]{8,64})['\"]",
    "severity": "MEDIUM",
    "entropy": 3.0
  },
  "Telegram Bot Token": {
    "regex": "\\b(?P<secret>\\d{8,10}:AA[0-9A-Za-z_-]{33})\\b",
    "severity": "HIGH"
  },
  "Square Access Token": {
    "regex": "\\b(?P<secret>EAAA[A-Za-z0-9_-]{60})\\b",
    "severity": "HIGH"
  },
  "Facebook Access Token": {
    "regex": "\\b(?P<secret>EAACEdEose0cBA[0-9A-Za-z]+)\\b",
    "severity": "HIGH"
  },
  "Mapbox Secret Token": {
    "regex": "\\b(?P<secret>sk\\.eyJ[A-Za-z0-9_-]{50,}\\.[A-Za-z0-9_-]{20,})\\b",
    "severity": "HIGH"
  },
  "Algolia Admin Key": {
    "regex": "(?i)algolia.{0,30}?admin.{0,20}?['\"](?P<secret>[a-f0-9]{32})['\"]",
    "severity": "HIGH"
  },
  "Sentry DSN": {
    "regex": "(?P<secret>https://[0-9a-f]{32}@[a-z0-9.]+\\.ingest\\.sentry\\.io/\\d+)",
    "severity": "INFO"
  },
  "Internal IP Address": {
    "regex": "\\b(?P<secret>(?:10\\.(?:\\d{1,3}\\.){2}\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}))\\b",
    "severity": "INFO"
  },
  "Stripe Restricted Key": {
    "regex": "\\b(?P<secret>rk_live_[0-9a-zA-Z]{24,99})\\b",
    "severity": "HIGH"
  },
  "Postman API Key": {
    "regex": "\\b(?P<secret>PMAK-[0-9a-f]{24}-[0-9a-f]{34})\\b",
    "severity": "HIGH"
  },
  "Atlassian API Token": {
    "regex": "\\b(?P<secret>ATATT3[A-Za-z0-9_\\-=]{180,})\\b",
    "severity": "HIGH"
  },
  "Linear API Key": {
    "regex": "\\b(?P<secret>lin_api_[A-Za-z0-9]{40})\\b",
    "severity": "HIGH"
  },
  "Doppler Token": {
    "regex": "\\b(?P<secret>dp\\.pt\\.[A-Za-z0-9]{43})\\b",
    "severity": "HIGH"
  },
  "DigitalOcean Token": {
    "regex": "\\b(?P<secret>dop_v1_[a-f0-9]{64})\\b",
    "severity": "CRITICAL"
  },
  "Cloudflare API Token": {
    "regex": "(?i)cloudflare.{0,30}?['\"](?P<secret>[A-Za-z0-9_-]{40})['\"]",
    "severity": "HIGH",
    "entropy": 4.0
  },
  "Supabase Service Key": {
    "regex": "(?i)service_?role.{0,40}?['\"](?P<secret>eyJ[A-Za-z0-9_-]{20,}\\.eyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,})['\"]",
    "severity": "CRITICAL"
  },
  "Firebase Server Key": {
    "regex": "\\b(?P<secret>AAAA[A-Za-z0-9_-]{7}:[A-Za-z0-9_-]{140})\\b",
    "severity": "HIGH"
  },
  "Datadog API Key": {
    "regex": "(?i)(?:datadog|dd)_?api_?key.{0,20}?['\"](?P<secret>[a-f0-9]{32})['\"]",
    "severity": "MEDIUM"
  },
  "New Relic Key": {
    "regex": "\\b(?P<secret>NRAK-[A-Z0-9]{27})\\b",
    "severity": "MEDIUM"
  },
  "Okta API Token": {
    "regex": "(?i)okta.{0,30}?['\"](?P<secret>00[A-Za-z0-9_-]{40})['\"]",
    "severity": "HIGH"
  }
}
