  "Fortinet FortiWeb": {"cookies": ["^FORTIWAFSID="], "body": [".fgd_icon", "Server Unavailable!.*?FortiWeb"]},
  "Citrix NetScaler": {"headers": {"via": "NS-CACHE", "cneonction": "close"}, "cookies": ["^ns_af=", "^citrix_ns_id", "^NSC_"], "body": ["NS Transaction ID"]},
